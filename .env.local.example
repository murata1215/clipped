# NextAuth 認証シークレット（openssl rand -base64 32 で生成）
AUTH_SECRET=

# Google OAuth 認証情報
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL 接続文字列
DATABASE_URL=postgresql://user:password@localhost:5432/clipped

# 画像保存先の絶対パス
UPLOAD_DIR=/var/www/html/clipped/uploads

# サイト URL
NEXT_PUBLIC_BASE_URL=https://clipped.app
